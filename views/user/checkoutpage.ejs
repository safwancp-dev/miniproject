<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link type="text/css" rel="stylesheet" href="/css/bootstrap.min.css" />
    <link type="text/css" rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --danger: #ef4444;
            --danger-dark: #dc2626;
            --success: #10b981;
            --text-dark: #1e293b;
            --text-medium: #475569;
            --text-light: #64748b;
            --border-color: #e2e8f0;
            --bg-light: #f8fafc;
            --shadow-sm: 0 1px 2px 0 rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
            --radius-sm: 0.375rem;
            --radius-md: 0.5rem;
            --radius-lg: 0.75rem;
            --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body, html {
            margin: 0;
            padding: 0;
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-medium);
            line-height: 1.6;
        }

        .section {
            padding: 2rem 0;
        }

        h1.mb-4 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 1.5rem;
            text-align: center;
            position: relative;
            padding-bottom: 0.5rem;
        }

        h1.mb-4:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: linear-gradient(to right, var(--primary), var(--danger));
            border-radius: 3px;
        }

        h3 {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1.25rem;
            color: var(--text-dark);
            display: flex;
            align-items: center;
        }

        h3 i {
            margin-right: 0.5rem;
            color: var(--primary);
            font-size: 1.35rem; /* Slightly larger icon */
        }

        #header {
            background-color: #1a1d29;
            padding: 1rem 0;
            box-shadow: var(--shadow-md);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        #header .header-logo a {
            font-size: 1.5rem;
            color: #fff;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        #header .header-logo a i {
            margin-right: 0.5rem;
            color: var(--primary);
        }

        .form-control, .form-select {
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 0.75rem 1rem;
            font-size: 0.9375rem;
            transition: var(--transition);
            background-color: white;
            box-shadow: var(--shadow-sm);
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
            outline: none;
        }

        label {
            font-weight: 500;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
            display: block;
            font-size: 0.9375rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
            position: relative;
        }

        .btn-danger {
            background: linear-gradient(to right, var(--danger), var(--danger-dark));
            border: none;
            color: white;
            font-size: 1rem;
            font-weight: 600;
            padding: 0.875rem 1.75rem;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: var(--transition);
            width: 100%;
            box-shadow: var(--shadow-sm);
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .btn-danger:hover {
            background: linear-gradient(to right, var(--danger-dark), var(--danger));
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }
        
        .btn-danger:active {
            transform: translateY(0);
            box-shadow: var(--shadow-sm);
        }


        .btn-primary {
            background: linear-gradient(to right, var(--primary), var(--primary-dark));
            border: none;
            color: white;
            padding: 0.625rem 1.25rem;
            font-size: 0.9375rem;
            font-weight: 500;
            border-radius: var(--radius-sm);
            transition: var(--transition);
            box-shadow: var(--shadow-sm);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-primary:hover {
            background: linear-gradient(to right, var(--primary-dark), var(--primary));
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .btn-primary:active {
            transform: translateY(0);
            box-shadow: var(--shadow-sm);
        }

        .btn-primary i {
            margin-right: 0.5rem;
        }

        .order-summary {
            background-color: white;
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-color);
            width: 100%;
            position: sticky;
            top: 6rem;
        }

        .order-summary h3 {
            font-size: 1.375rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            text-align: center;
            color: var(--text-dark);
            justify-content: center;
        }

        .order-items-container {
            max-height: 400px;
            overflow-y: auto;
            padding-right: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .order-items-container::-webkit-scrollbar {
            width: 6px;
        }

        .order-items-container::-webkit-scrollbar-track {
            background: var(--bg-light);
            border-radius: 10px;
        }

        .order-items-container::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 10px;
        }

        .order-items-container::-webkit-scrollbar-thumb:hover {
            background: var(--text-light);
        }

        .order-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 1.25rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid var(--border-color);
        }

        .order-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .order-item-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: var(--radius-sm);
            margin-right: 1rem;
            box-shadow: var(--shadow-sm);
            flex-shrink: 0;
        }

        .order-item-details {
            flex-grow: 1;
        }

        .order-item-name {
            font-weight: 600;
            font-size: 0.9375rem;
            color: var(--text-dark);
            margin-bottom: 0.375rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .order-item-qty {
            font-size: 0.8125rem;
            color: var(--text-light);
            margin-bottom: 0.375rem;
        }

        .order-item-price {
            font-weight: 700;
            font-size: 0.9375rem;
            color: var(--text-dark);
        }

        .summary-total {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1.25rem;
            margin-top: 1.25rem;
            border-top: 1px solid var(--border-color);
        }

        .summary-total-label {
            font-weight: 600;
            font-size: 1rem;
            color: var(--text-dark);
        }

        .summary-total-amount {
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--danger);
        }

        .payment-method-card {
            background: white;
            border-radius: var(--radius-md);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-color);
        }

        .payment-method-option {
            display: flex;
            align-items: center;
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            margin-bottom: 0.75rem;
            cursor: pointer;
            transition: var(--transition);
            background-color: var(--bg-light); /* Slight background for options */
        }

        .payment-method-option:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow-sm);
            transform: translateY(-1px); /* Subtle lift on hover */
        }

        .payment-method-option.active {
            border-color: var(--primary);
            background-color: rgba(99, 102, 241, 0.08); /* More pronounced active state */
            box-shadow: var(--shadow-md);
        }

        .payment-method-option input[type="radio"] {
            margin-right: 0.75rem;
            width: 1.15em; /* Custom radio button size */
            height: 1.15em;
            accent-color: var(--primary); /* Tint radio button */
        }

        .payment-method-icon {
            margin-right: 0.75rem;
            color: var(--primary);
            font-size: 1.3rem; /* Slightly larger icon */
        }

        .payment-method-label {
            font-weight: 500;
            color: var(--text-dark);
            cursor: pointer; /* Ensure label is clickable for radio */
            flex-grow: 1; /* Allow label to take available space */
        }

        .coupon-input-group {
            display: flex;
            gap: 0.75rem;
        }

        .coupon-input-group .form-control {
            flex-grow: 1;
        }

        .empty-cart-message {
            text-align: center;
            padding: 2rem;
            color: var(--text-light);
            background-color: white;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-color);
        }

        .empty-cart-message i {
            font-size: 2.5rem; /* Larger icon */
            margin-bottom: 1rem;
            color: var(--border-color);
        }

        .empty-cart-message p {
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
            color: var(--text-medium);
        }

        /* Adjust "Add New Address" button within its card */
        .shipping-info .form-group.text-center {
            margin-bottom: 1.5rem; /* Standard spacing */
            padding-top: 0.5rem; /* Little padding above the button if needed */
        }

        @media (max-width: 767.98px) {
            .section {
                padding: 1.5rem 0;
            }

            .order-summary {
                position: static;
                margin-top: 2rem;
            }
            h1.mb-4 {
                font-size: 1.75rem;
            }
            h3 {
                font-size: 1.15rem;
            }
            .btn-danger {
                padding: 0.75rem 1.5rem;
                font-size: 0.9rem;
            }
        }
    </style>
</head>

<body>
    <header>
        <div id="header">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-3">
                        <div class="header-logo">
                            <a href class="logo"><i class="fas fa-store-alt"></i> Apz Store</a>
                        </div>
                    </div>
                    <div class="col-md-9"></div>
                </div>
            </div>
        </div>
    </header>

    <div class="section">
        <div class="container">
            <h1 class="mb-4">Checkout</h1>
            <div class="row">
                <div class="col-lg-8">
                    <form action="/place-order" method="POST">
                        <div class="billing-info mb-5">
                            <div class="payment-method-card">
                                <h3><i class="fas fa-user"></i> Contact Information</h3>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="fullName">Full Name</label>
                                            <input type="text" id="fullName" name="fullName" class="form-control" placeholder="Enter your full name" required />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="phone">Phone Number</label>
                                            <input type="text" id="phone" name="addressId[phone]" class="form-control" placeholder="Enter your phone number" required />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="payment-method-card shipping-info"> <h3><i class="fas fa-truck"></i> Shipping Information</h3>
                                <div class="form-group">
                                    <label for="savedAddress">Saved Addresses</label>
                                    <select name="savedAddress" id="savedAddress" class="form-select">
                                        <option value=""> Select a saved address </option>
                                        <% addresses.forEach((address) => { %>
                                            <option
                                                value="<%= address._id %>"
                                                data-fullname="<%= address.fullName %>"
                                                data-address="<%= address.address %>"
                                                data-city="<%= address.city %>"
                                                data-postal="<%= address.postalCode %>"
                                                data-phone="<%= address.phone %>"
                                            >
                                                <%= address.address %>, <%= address.city %> - <%= address.postalCode %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="form-group text-center">
                                    <a href="/my-account" class="btn btn-primary"><i class="fas fa-plus"></i> Add New Address</a>
                                </div>

                                <div class="form-group">
                                    <label for="address">Shipping Address</label>
                                    <textarea id="address" name="addressId[address]" class="form-control" rows="3" placeholder="Enter your complete shipping address" required></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="city">City</label>
                                            <input type="text" id="city" name="addressId[city]" class="form-control" placeholder="Enter your city" required />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="postalCode">Postal Code</label>
                                            <input type="text" id="postalCode" name="addressId[postalCode]" class="form-control" placeholder="Enter postal code" required />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="payment-method-card">
                                <h3><i class="fas fa-credit-card"></i> Payment Method</h3>
                                <div class="form-group">
                                    <div class="payment-method-option">
                                        <input type="radio" id="cod" name="paymentMethod" value="COD" required>
                                        <i class="fas fa-money-bill-wave payment-method-icon"></i>
                                        <label for="cod" class="payment-method-label">Cash on Delivery</label>
                                    </div>
                                    <div class="payment-method-option">
                                        <input type="radio" id="online" name="paymentMethod" value="Online">
                                        <i class="fas fa-globe payment-method-icon"></i>
                                        <label for="online" class="payment-method-label">Online Payment</label>
                                    </div>
                                </div>
                            </div>

                            <div class="payment-method-card">
                                <h3><i class="fas fa-tag"></i> Coupon Code</h3>
                                <div class="coupon-input-group">
                                    <input type="text" id="couponCode" name="couponCode" class="form-control" placeholder="Enter coupon code" />
                                    
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-lock"></i> Place Order Securely
                            </button>
                        </div>
                    </form>
                </div>

                <div class="col-lg-4">
                    <div class="order-summary">
                        <h3><i class="fas fa-shopping-bag"></i> Order Summary</h3>
                        <% if (cartItems && cartItems.length > 0) { %>
                            <div class="order-items-container">
                                <% cartItems.forEach(item => { %>
                                    <div class="order-item">
                                        <% if (item.product && item.product.image && item.product.image.length > 0) { %>
                                            <img src="<%= item.product.image[0] %>" alt="<%= item.product.name %>" class="order-item-img">
                                        <% } else { %>
                                            <div class="order-item-img" style="background-color: #eee; display: flex; justify-content: center; align-items: center;">
                                                <i class="fas fa-image" style="color: #ccc; font-size: 1.5rem;"></i>
                                            </div>
                                        <% } %>
                                        <div class="order-item-details">
                                            <div class="order-item-name"><%= item.product.name %></div>
                                            <div class="order-item-qty">Quantity: <strong><%= item.quantity %></strong></div>
                                            <div class="order-item-price">₹<%= (item.product.price * item.quantity).toFixed(2) %></div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                            <div class="summary-total">
                                <span class="summary-total-label">Total:</span>
                                <span class="summary-total-amount">₹<%= totalAmount.toFixed(2) %></span>
                            </div>
                        <% } else { %>
                            <div class="empty-cart-message">
                                <i class="fas fa-shopping-cart"></i>
                                <p>Your cart is empty</p>
                                <a href="/" class="btn btn-primary">Continue Shopping</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script>
        $(document).ready(function () {
            // Address selection handler
            $('#savedAddress').on('change', function () {
                const selected = $(this).find(':selected');
                if (selected.val()) {
                    $('#fullName').val(selected.data('fullname') || '');
                    $('#address').val(selected.data('address') || '');
                    $('#city').val(selected.data('city') || '');
                    $('#postalCode').val(selected.data('postal') || '');
                    $('#phone').val(selected.data('phone') || '');
                } else {
                    // Clear fields if "Select a saved address" is chosen
                    $('#fullName').val('');
                    $('#address').val('');
                    $('#city').val('');
                    $('#postalCode').val('');
                    $('#phone').val('');
                }
            });

            // Payment method selection styling
            $('.payment-method-option').click(function() {
                $('.payment-method-option').removeClass('active');
                $(this).addClass('active');
                $(this).find('input[type="radio"]').prop('checked', true).trigger('change'); // Trigger change for radio button
            });

            // Ensure the active class is set on page load if a radio button is checked
            $('input[name="paymentMethod"]:checked').parent('.payment-method-option').addClass('active');


            // Coupon code apply button
            $('.coupon-input-group button').click(function() {
                const couponCode = $('#couponCode').val();
                if (couponCode.trim() === '') {
                    alert('Please enter a coupon code');
                    return;
                }
                // In a real application, you would make an AJAX call here
                // For demonstration, we'll just show an alert
                alert('Coupon code "' + couponCode + '" applied! (This is a demo message)');
                // You would then update the totalAmount dynamically if the coupon is valid
            });
        });
    </script>
</body>
</html>